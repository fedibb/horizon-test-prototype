        "fallback_network": "LTE",
        "registration_timeout": 0.1,
        "max_retry_attempts": 3,
        "expected_behavior": "automatic_fallback"
      },
      "acceptance_criteria": {
        "A1": "Network registration completes successfully",
        "E1": "5G SA registration is attempted first",
        "E2": "Fallback to LTE occurs within 60 seconds",
        "E3": "LTE registration is successful",
        "E4": "Error code is logged correctly",
        "E5": "No manual intervention required"
      }
    }
  ]
